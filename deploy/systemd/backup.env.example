# Root-owned 0600 file. These are data, not shell commands or executable hooks.
# Install the server's diffmind.service separately; use the exact service name.
DIFFMIND_SERVICE=diffmind.service
DIFFMIND_BINARY=/usr/local/bin/diffmind
DIFFMIND_HOME=/srv/diffmind
DIFFMIND_BACKUP_DIRECTORY=/var/backups/diffmind
DIFFMIND_BACKUP_KEEP_LAST=7
DIFFMIND_BACKUP_LOCK=/run/diffmind-backup/rotation.lock
