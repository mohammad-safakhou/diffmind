#!/bin/sh
set -eu
test "$#" = 8
test "$1" = backup && test "$2" = rotate && test "$3" = --offline
test "$4" = --directory && test "$5" = "$TEST_ROOT/backups with spaces"
test "$6" = --keep-last && test "$7" = 7 && test "$8" = --json
test "$DIFFMIND_HOME" = "$TEST_ROOT/home with spaces"
echo backup >> "$TEST_ROOT/actions"
if [ "$TEST_FAIL" = wait ]; then
  trap 'echo child-stopped >> "$TEST_ROOT/actions"; exit 143' TERM
  touch "$TEST_ROOT/ready"
  while :; do sleep 0.05; done
fi
test "$TEST_FAIL" != backup
