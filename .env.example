# Generate a value with: openssl rand -hex 32
DIFFMIND_AUTH_TOKEN=replace-with-a-long-random-value

# Optional: enable per-user identity from a trusted OIDC reverse proxy.
# Generate a separate value; never reuse DIFFMIND_AUTH_TOKEN.
DIFFMIND_TRUSTED_PROXY_SECRET=

# Opt in to explicit project memberships. Configure grants with an admin first.
DIFFMIND_PROJECT_ACCESS=legacy

# Optional settings.
DIFFMIND_PORT=8090
DIFFMIND_REFRESH_INTERVAL=15m
DIFFMIND_REFRESH_CONCURRENCY=4
DIFFMIND_JOB_WORKERS=2
DIFFMIND_QUEUE_CAPACITY=256
DIFFMIND_REPOSITORY_WORKERS=4

# Optional GitHub push webhooks. Separate secret, >=32 bytes; blank disables.
# Generate with: openssl rand -hex 32
DIFFMIND_WEBHOOK_SECRET=

# Needed only when importing or refreshing private GitHub repositories.
GITHUB_TOKEN=
